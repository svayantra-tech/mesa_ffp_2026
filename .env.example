# ─── Public site URL (drives metadataBase → og:url / og:image) ───────────────
# Production: set to the real host. Preview deploys fall back to VERCEL_URL,
# then to https://ffp.mesaschool.me. Set this in Vercel project settings.
NEXT_PUBLIC_SITE_URL=https://ffp.mesaschool.me

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=
# Optional: comma-separated DNS servers for Atlas SRV resolution (e.g. 8.8.8.8,1.1.1.1)
MONGODB_DNS=

# ─── Asset upload (image hosting) ────────────────────────────────────────────
FFP_ASSET_UPLOAD_URL=https://msl-portal-backend.mesaschool.co.in/api/ffp-asset-upload

# ─── Admin panel ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ─── Supabase (static client) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
